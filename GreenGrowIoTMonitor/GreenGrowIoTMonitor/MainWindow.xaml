<Window x:Class="GreenGrowIoTMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GreenGrow IoT Monitor"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F2F6F3">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#245C3A"
                CornerRadius="12"
                Padding="25"
                Margin="0,0,0,20">

            <Grid>

                <StackPanel>
                    <TextBlock Text="GreenGrow IoT Monitor"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="SmartFarm Environmental Monitoring"
                               Foreground="#D9EBDD"
                               FontSize="15"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Location: Pretoria, South Africa"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,12,0,0"/>
                </StackPanel>

            </Grid>

        </Border>


        <!-- STATUS BAR -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D5DED8"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="SYSTEM STATUS:"
                               FontWeight="Bold"
                               Foreground="#444444"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="StatusText"
                               Text="OFFLINE"
                               Foreground="#B3261E"
                               FontWeight="Bold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="LastUpdatedText"
                           Text="Last updated: --"
                           Foreground="#666666"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- Main Content -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Sensor Readings -->
            <StackPanel Grid.Column="0"
                        Margin="0,0,15,0">

                <TextBlock Text="Current Environmental Readings"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#245C3A"
                           Margin="0,0,0,15"/>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- Temperature -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Background="White"
                            BorderBrush="#D5DED8"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,10,10">

                        <StackPanel>

                            <TextBlock Text="Temperature"
                                       FontSize="15"
                                       Foreground="#666666"/>

                            <TextBlock x:Name="TemperatureText"
                                       Text="-- °C"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#245C3A"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- Humidity -->
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Background="White"
                            BorderBrush="#D5DED8"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="10,0,0,10">

                        <StackPanel>

                            <TextBlock Text="Relative Humidity"
                                       FontSize="15"
                                       Foreground="#666666"/>

                            <TextBlock x:Name="HumidityText"
                                       Text="-- %"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#245C3A"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- Wind Speed -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Background="White"
                            BorderBrush="#D5DED8"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,10,10,0">

                        <StackPanel>

                            <TextBlock Text="Wind Speed"
                                       FontSize="15"
                                       Foreground="#666666"/>

                            <TextBlock x:Name="WindText"
                                       Text="-- km/h"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#245C3A"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- Soil Moisture -->
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Background="White"
                            BorderBrush="#D5DED8"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="10,10,0,0">

                        <StackPanel>

                            <TextBlock Text="Soil Moisture"
                                       FontSize="15"
                                       Foreground="#666666"/>

                            <TextBlock x:Name="SoilMoistureText"
                                       Text="-- %"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#245C3A"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </StackPanel>


            <!-- History -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#D5DED8"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Temperature History"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#245C3A"/>

                    <TextBlock Text="Stack - Last In, First Out"
                               Foreground="#777777"
                               FontSize="13"
                               Margin="0,3,0,20"/>


                    <TextBlock Text="Latest Stored Reading"
                               FontWeight="Bold"
                               Foreground="#555555"/>

                    <TextBlock x:Name="LatestReadingText"
                               Text="No readings stored"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#245C3A"
                               Margin="0,8,0,20"/>


                    <TextBlock Text="Number of Stored Readings"
                               FontWeight="Bold"
                               Foreground="#555555"/>

                    <TextBlock x:Name="ReadingCountText"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#245C3A"
                               Margin="0,8,0,25"/>


                    <Button x:Name="RetrieveButton"
                            Content="Retrieve New Data"
                            Height="45"
                            Background="#245C3A"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="RetrieveButton_Click"
                            Margin="0,0,0,10"/>


                    <Button x:Name="PeekButton"
                            Content="View Latest Reading"
                            Height="45"
                            Background="#4C8061"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="PeekButton_Click"
                            Margin="0,0,0,10"/>


                    <Button x:Name="PopButton"
                            Content="Remove Latest Reading"
                            Height="45"
                            Background="#8B5E3C"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="PopButton_Click"/>

                </StackPanel>

            </Border>

        </Grid>


        <!--Page footer-->
        <TextBlock Grid.Row="3"
                   Text="GreenGrow IoT Monitor | Open-Meteo Environmental Data"
                   HorizontalAlignment="Center"
                   Foreground="#777777"
                   FontSize="12"
                   Margin="0,20,0,0"/>

    </Grid>

</Window>